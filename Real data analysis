# 1. MLE (baseline) - from Singh et al. (2024)

# 2. Stein Estimator (your simulation shows this is best overall)
stein_estimator <- function(r_hat, n, R0) {
  var_est <- r_hat * (1 - r_hat) / n
  lambda <- var_est / (var_est + (r_hat - R0)^2 + 1e-8)
  return((1 - lambda) * r_hat + lambda * R0)
}

# 3. Positive-Part Stein (slightly better than Stein near boundaries)
positive_stein <- function(r_hat, n, R0) {
  var_est <- r_hat * (1 - r_hat) / n
  z_sq <- (r_hat - R0)^2 / (var_est + 1e-8)
  shrinkage <- max(0, 1 - 1/(z_sq + 1e-8))
  return(R0 + shrinkage * (r_hat - R0))
}

# 4. PTE - Smooth Preliminary Test Estimator (from your simulation)
pte_estimator <- function(r_hat, n, R0, alpha = 0.05) {
  var_est <- r_hat * (1 - r_hat) / n
  Tstat <- ((r_hat - R0)^2) / (var_est + 1e-8)
  crit <- qchisq(1 - alpha, df = 1)
  w <- exp(-Tstat / crit)
  return(w * R0 + (1 - w) * r_hat)
}

# 5. Bayes Estimator (adaptive prior)
bayes_estimator <- function(r_hat, n, R0) {
  prior_strength <- sqrt(n)
  a0 <- R0 * prior_strength
  b0 <- (1 - R0) * prior_strength
  return((a0 + n * r_hat) / (a0 + b0 + n))
}

# 6. Convex Estimator (simple shrinkage)
convex_estimator <- function(r_hat, n, R0) {
  alpha <- 1 - min(0.4, 10 / n)
  return(alpha * r_hat + (1 - alpha) * R0)
}

############################################################
# BOOTSTRAP FOR MSE AND IMPROVEMENT
############################################################

bootstrap_analysis <- function(r_hat, n, R0, B = 1000) {
  
  # Function to compute all estimators
  compute_all <- function(r_val) {
    r_val <- min(max(r_val, 0.001), 0.999)
    c(
      MLE = r_val,
      Stein = stein_estimator(r_val, n, R0),
      PositiveStein = positive_stein(r_val, n, R0),
      PTE = pte_estimator(r_val, n, R0),
      Bayes = bayes_estimator(r_val, n, R0),
      Convex = convex_estimator(r_val, n, R0)
    )
  }
  
  # Bootstrap resampling
  boot_estimates <- replicate(B, {
    # Generate bootstrap MLE with proper variance
    var_mle <- r_hat * (1 - r_hat) / n
    r_boot <- rnorm(1, mean = r_hat, sd = sqrt(var_mle))
    r_boot <- min(max(r_boot, 0.001), 0.999)
    compute_all(r_boot)
  })
  
  # Calculate statistics
  boot_mean <- rowMeans(boot_estimates)
  boot_var <- apply(boot_estimates, 1, var)
  boot_se <- sqrt(boot_var)
  
  # MSE (using true r_hat as truth)
  mse <- boot_var + (boot_mean - r_hat)^2
  
  # MSE improvement relative to MLE
  mse_improvement <- (mse["MLE"] - mse) / mse["MLE"] * 100
  
  # Relative efficiency
  rel_eff <- mse["MLE"] / mse
  
  return(list(
    Estimate = boot_mean,
    SE = boot_se,
    MSE = mse,
    MSE_Improvement = mse_improvement,
    RelativeEfficiency = rel_eff
  ))
}

